<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- ================= INSTALLATION STAGES ================= -->
        <record id="stage_installation_1" model="elevator.work.order.stage">
            <field name="name">1. Site Readiness &amp; Shaft Prep</field>
            <field name="sequence">10</field>
            <field name="stage_type">installation</field>
            <field name="require_document" eval="True"/>
            <field name="required_doc_description">Upload Shaft Plumb Line &amp; Power Supply Readiness Checklist</field>
            <field name="can_bill_contractor" eval="True"/>
            <field name="contractor_payment_percentage">15.0</field>
            <field name="is_closed" eval="False"/>
        </record>

        <record id="stage_installation_2" model="elevator.work.order.stage">
            <field name="name">2. Guide Rails &amp; Brackets</field>
            <field name="sequence">20</field>
            <field name="stage_type">installation</field>
            <field name="require_document" eval="True"/>
            <field name="required_doc_description">Upload Guide Rail Alignment &amp; Pit Buffer Inspection Sheet</field>
            <field name="can_bill_contractor" eval="True"/>
            <field name="contractor_payment_percentage">20.0</field>
            <field name="is_closed" eval="False"/>
        </record>

        <record id="stage_installation_3" model="elevator.work.order.stage">
            <field name="name">3. Cabin &amp; Mechanical Assembly</field>
            <field name="sequence">30</field>
            <field name="stage_type">installation</field>
            <field name="require_document" eval="True"/>
            <field name="required_doc_description">Upload Car Sling, Counterweight &amp; Door Operator Mechanical Check Sheet</field>
            <field name="can_bill_contractor" eval="True"/>
            <field name="contractor_payment_percentage">25.0</field>
            <field name="is_closed" eval="False"/>
        </record>

        <record id="stage_installation_4" model="elevator.work.order.stage">
            <field name="name">4. Motor, Cables &amp; Electrical Wiring</field>
            <field name="sequence">40</field>
            <field name="stage_type">installation</field>
            <field name="require_document" eval="True"/>
            <field name="required_doc_description">Upload Traction Motor &amp; Control Cabinet Electrical Wiring Test Sheet</field>
            <field name="can_bill_contractor" eval="True"/>
            <field name="contractor_payment_percentage">20.0</field>
            <field name="is_closed" eval="False"/>
        </record>

        <record id="stage_installation_5" model="elevator.work.order.stage">
            <field name="name">5. Safety Testing &amp; Commissioning</field>
            <field name="sequence">50</field>
            <field name="stage_type">installation</field>
            <field name="require_document" eval="True"/>
            <field name="required_doc_description">Upload Certified Safety Drop Test, Governor &amp; Brake Test Certificate</field>
            <field name="can_bill_contractor" eval="True"/>
            <field name="contractor_payment_percentage">15.0</field>
            <field name="is_closed" eval="False"/>
        </record>

        <record id="stage_installation_6" model="elevator.work.order.stage">
            <field name="name">6. Handover &amp; Completion</field>
            <field name="sequence">60</field>
            <field name="stage_type">installation</field>
            <field name="require_document" eval="True"/>
            <field name="required_doc_description">Upload Customer Signed Acceptance &amp; Handover Certificate</field>
            <field name="can_bill_contractor" eval="True"/>
            <field name="contractor_payment_percentage">5.0</field>
            <field name="is_closed" eval="True"/>
        </record>

        <!-- ================= MAINTENANCE STAGES ================= -->
        <record id="stage_maintenance_1" model="elevator.work.order.stage">
            <field name="name">Scheduled Inspection</field>
            <field name="sequence">100</field>
            <field name="stage_type">maintenance</field>
            <field name="require_document" eval="False"/>
            <field name="is_closed" eval="False"/>
        </record>

        <record id="stage_maintenance_2" model="elevator.work.order.stage">
            <field name="name">On-Site Servicing &amp; Lubrication</field>
            <field name="sequence">110</field>
            <field name="stage_type">maintenance</field>
            <field name="require_document" eval="False"/>
            <field name="is_closed" eval="False"/>
        </record>

        <record id="stage_maintenance_3" model="elevator.work.order.stage">
            <field name="name">Completed &amp; Signed Off</field>
            <field name="sequence">120</field>
            <field name="stage_type">maintenance</field>
            <field name="require_document" eval="True"/>
            <field name="required_doc_description">Upload Signed Monthly Maintenance Sheet by Building Supervisor</field>
            <field name="is_closed" eval="True"/>
        </record>

        <!-- ================= REPAIR / SPARE PARTS REPLACEMENT STAGES ================= -->
        <record id="stage_repair_1" model="elevator.work.order.stage">
            <field name="name">1. Dispatch &amp; Site Diagnosis</field>
            <field name="sequence">200</field>
            <field name="stage_type">repair</field>
            <field name="require_document" eval="False"/>
            <field name="is_closed" eval="False"/>
        </record>

        <record id="stage_repair_2" model="elevator.work.order.stage">
            <field name="name">2. Parts Replacement &amp; Operational Test</field>
            <field name="sequence">210</field>
            <field name="stage_type">repair</field>
            <field name="require_document" eval="True"/>
            <field name="required_doc_description">Upload Photo of Installed Replacement Part (e.g. Elevator Button/COP) &amp; Operational Test</field>
            <field name="can_bill_contractor" eval="True"/>
            <field name="contractor_payment_percentage">50.0</field>
            <field name="is_closed" eval="False"/>
        </record>

        <record id="stage_repair_3" model="elevator.work.order.stage">
            <field name="name">3. Customer Sign-off &amp; Completion</field>
            <field name="sequence">220</field>
            <field name="stage_type">repair</field>
            <field name="require_document" eval="True"/>
            <field name="required_doc_description">Upload Customer Signed Repair Job Completion &amp; Satisfaction Sheet</field>
            <field name="can_bill_contractor" eval="True"/>
            <field name="contractor_payment_percentage">50.0</field>
            <field name="is_closed" eval="True"/>
        </record>
    </data>
</odoo>
