<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- KANBAN VIEW -->
    <record id="view_elevator_work_order_kanban" model="ir.ui.view">
        <field name="name">elevator.work.order.kanban</field>
        <field name="model">elevator.work.order</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" class="o_kanban_small_column" sample="1">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="site_id"/>
                <field name="stage_id"/>
                <field name="priority"/>
                <field name="order_type"/>
                <field name="contractor_type"/>
                <field name="contractor_id"/>
                <field name="document_count"/>
                <field name="subcontract_budget"/>
                <field name="currency_id"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top mb-1">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                </div>
                                <field name="priority" widget="priority"/>
                            </div>
                            <div class="text-muted small mb-1">
                                <i class="fa fa-user me-1"/> <field name="partner_id"/>
                            </div>
                            <div class="text-muted small mb-1">
                                <i class="fa fa-building-o me-1"/> <field name="site_id"/>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top">
                                <div>
                                    <span t-if="record.contractor_type.raw_value == 'external'" class="badge text-bg-warning">
                                        <i class="fa fa-handshake-o me-1"/> <field name="contractor_id"/>
                                    </span>
                                    <span t-else="" class="badge text-bg-info">
                                        <i class="fa fa-users me-1"/> Internal Team
                                    </span>
                                </div>
                                <div class="badge text-bg-light border">
                                    <i class="fa fa-paperclip me-1"/> <field name="document_count"/> papers
                                </div>
                            </div>
                            <div class="mt-2 text-end text-success fw-bold small" t-if="record.subcontract_budget.raw_value">
                                <field name="subcontract_budget" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- LIST / TREE VIEW -->
    <record id="view_elevator_work_order_tree" model="ir.ui.view">
        <field name="name">elevator.work.order.list</field>
        <field name="model">elevator.work.order</field>
        <field name="arch" type="xml">
            <list string="Elevator Work Orders" decoration-info="state == 'draft'" decoration-warning="state == 'in_progress'" decoration-success="state == 'done'">
                <field name="priority" widget="priority" optional="show"/>
                <field name="name"/>
                <field name="order_type"/>
                <field name="partner_id"/>
                <field name="site_id"/>
                <field name="stage_id"/>
                <field name="origin_company_id" string="Company A (Sales)" groups="base.group_multi_company"/>
                <field name="company_id" string="Company B (Execution)" groups="base.group_multi_company"/>
                <field name="contractor_type"/>
                <field name="contractor_id" optional="show"/>
                <field name="subcontract_budget" widget="monetary" options="{'currency_field': 'currency_id'}" optional="show"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="document_count" string="Docs"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'in_progress'"
                       decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_elevator_work_order_form" model="ir.ui.view">
        <field name="name">elevator.work.order.form</field>
        <field name="model">elevator.work.order</field>
        <field name="arch" type="xml">
            <form string="Elevator Work Order">
                <header>
                    <button name="action_start" string="Start Work On-Site" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_next_stage" string="Next Stage ▶" type="object" class="btn-primary" invisible="state != 'in_progress'"/>
                    <button name="action_upload_paperwork" string="Upload Stage Paperwork 📄" type="object" class="btn-secondary"/>
                    <button name="action_create_contractor_bill" string="Generate Contractor Vendor Bill 💵" type="object" class="btn-success" invisible="contractor_type != 'external' or state not in ['in_progress', 'done']"/>
                    <button name="action_mark_done" string="Mark Handover Complete ✔" type="object" class="btn-outline-success" invisible="state != 'in_progress'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,done"/>
                </header>

                <!-- STAGE GATING ALERT -->
                <div class="alert alert-warning mb-0" role="alert" invisible="not stage_require_doc">
                    <i class="fa fa-exclamation-triangle me-2"/>
                    <strong>Stage Gating Condition Active:</strong>
                    Upload of signed documents/evidence is mandatory for stage <b><field name="stage_id" readonly="1" options="{'no_open': True}" class="d-inline"/></b>:
                    <span class="fw-bold"><field name="stage_doc_instructions" readonly="1" class="d-inline"/></span>.
                    <button name="action_upload_paperwork" type="object" string="Upload Paperwork Now" class="btn btn-sm btn-dark ms-3"/>
                </div>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_upload_paperwork" type="object" class="oe_stat_button" icon="fa-paperclip">
                            <field name="document_count" widget="statinfo" string="Paperwork / Checklists"/>
                        </button>
                        <button name="action_view_contractor_bills" type="object" class="oe_stat_button" icon="fa-credit-card" invisible="contractor_bill_count == 0">
                            <field name="contractor_bill_count" widget="statinfo" string="Contractor Bills"/>
                        </button>
                        <button name="action_view_site_deliveries" type="object" class="oe_stat_button" icon="fa-truck" invisible="delivery_order_count == 0">
                            <field name="delivery_order_count" widget="statinfo" string="Site Deliveries (Co. A)"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <div class="d-flex align-items-center">
                            <field name="priority" widget="priority" class="me-3"/>
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <h3>
                            <field name="order_type" widget="radio" options="{'horizontal': true}"/>
                        </h3>
                    </div>

                    <group>
                        <group string="Multi-Company Delegation &amp; Origin">
                            <field name="origin_company_id" string="Company A (Sales Company)" groups="base.group_multi_company"/>
                            <field name="sale_order_id" string="Company A Sale Order"/>
                            <field name="company_id" string="Company B (Executing Company)" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                            <label for="subcontract_budget" string="Company B Internal Budget (Allocation)"/>
                            <div class="o_row">
                                <field name="subcontract_budget" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                <span class="text-muted">(Company B internal revenue)</span>
                            </div>
                        </group>
                        <group string="Site &amp; Elevator Unit">
                            <field name="partner_id"/>
                            <field name="site_id"/>
                            <field name="elevator_unit_id"/>
                            <field name="contract_id" invisible="not contract_id"/>
                        </group>
                    </group>

                    <group>
                        <group string="Stage &amp; Scheduling">
                            <field name="stage_id" options="{'no_create': True}"/>
                            <field name="stage_require_doc" invisible="1"/>
                            <field name="stage_doc_instructions" invisible="1"/>
                            <field name="date_planned_start"/>
                            <field name="date_planned_end"/>
                            <field name="date_completed" invisible="not date_completed"/>
                        </group>
                        <group string="Assigned Execution Team">
                            <field name="contractor_type" widget="radio"/>
                            <field name="technician_ids" widget="many2many_tags" invisible="contractor_type != 'internal'"/>
                            <field name="contractor_id" invisible="contractor_type != 'external'" required="contractor_type == 'external'"/>
                            <field name="contractor_cost" widget="monetary" options="{'currency_field': 'currency_id'}" invisible="contractor_type != 'external'"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Stage Paperwork &amp; Checklists" name="documents">
                            <field name="document_ids">
                                <list string="Uploaded Documents" editable="bottom">
                                    <field name="name"/>
                                    <field name="stage_id"/>
                                    <field name="document_type"/>
                                    <field name="file" filename="file_name" widget="binary"/>
                                    <field name="file_name" column_invisible="True"/>
                                    <field name="uploaded_by"/>
                                    <field name="upload_date"/>
                                    <field name="is_approved" widget="boolean_toggle"/>
                                    <button name="action_approve" type="object" string="Approve" icon="fa-check" invisible="is_approved" class="btn-success"/>
                                </list>
                            </field>
                        </page>

                        <page string="Materials Consumed On-Site" name="materials">
                            <field name="material_line_ids">
                                <list string="Materials Used" editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="source_location"/>
                                    <field name="notes" placeholder="Batch / Serial / Notes"/>
                                </list>
                            </field>
                        </page>

                        <page string="Site Deliveries from Company A" name="deliveries">
                            <field name="stock_picking_ids" readonly="1">
                                <list string="Deliveries Arrived on Site">
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="origin"/>
                                    <field name="company_id" string="Delivered by Company"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>

                        <page string="Contractor Billing &amp; Vendor Bills" name="contractor_billing" invisible="contractor_type != 'external'">
                            <group>
                                <group>
                                    <field name="contractor_id" readonly="1"/>
                                    <field name="contractor_cost" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                </group>
                            </group>
                            <field name="contractor_bill_ids" readonly="1">
                                <list string="Vendor Bills">
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="ref"/>
                                    <field name="invoice_date"/>
                                    <field name="amount_total" widget="monetary"/>
                                    <field name="payment_state" widget="badge"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>

                        <page string="Instructions &amp; Site Notes" name="notes">
                            <field name="notes" placeholder="Enter detailed technical instructions for on-site execution..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="view_elevator_work_order_search" model="ir.ui.view">
        <field name="name">elevator.work.order.search</field>
        <field name="model">elevator.work.order</field>
        <field name="arch" type="xml">
            <search string="Search Work Orders">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="site_id"/>
                <field name="contractor_id"/>
                <field name="sale_order_id"/>
                <filter string="In Progress" name="filter_in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Completed" name="filter_done" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter string="New Installations" name="filter_installation" domain="[('order_type', '=', 'installation')]"/>
                <filter string="Repairs &amp; Parts Replacement" name="filter_repair" domain="[('order_type', '=', 'repair')]"/>
                <filter string="Maintenance Visits" name="filter_maintenance" domain="[('order_type', '=', 'maintenance')]"/>
                <separator/>
                <filter string="External Contractor" name="filter_contractor" domain="[('contractor_type', '=', 'external')]"/>
                <filter string="High Priority" name="filter_urgent" domain="[('priority', 'in', ['1', '2'])]"/>
                <group expand="0" string="Group By">
                    <filter string="Stage" name="group_stage" domain="[]" context="{'group_by': 'stage_id'}"/>
                    <filter string="Status" name="group_state" domain="[]" context="{'group_by': 'state'}"/>
                    <filter string="Site" name="group_site" domain="[]" context="{'group_by': 'site_id'}"/>
                    <filter string="Customer" name="group_customer" domain="[]" context="{'group_by': 'partner_id'}"/>
                    <filter string="Contractor" name="group_contractor" domain="[]" context="{'group_by': 'contractor_id'}"/>
                    <filter string="Executing Company" name="group_company" domain="[]" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ACTIONS -->
    <record id="action_elevator_work_order" model="ir.actions.act_window">
        <field name="name">Elevator Work Orders</field>
        <field name="res_model">elevator.work.order</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_filter_in_progress': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create or manage elevator installation and maintenance work orders!
            </p>
        </field>
    </record>

    <record id="action_elevator_work_order_repair" model="ir.actions.act_window">
        <field name="name">Repairs &amp; Parts Replacement</field>
        <field name="res_model">elevator.work.order</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('order_type', '=', 'repair')]</field>
        <field name="context">{'default_order_type': 'repair'}</field>
    </record>
</odoo>
